void enterstring(char input[])
{
    printf("Enter the string: ");
    scanf("%99s", input);

}

int palindrome(char input[])
{
    int i= 0, j= 0;
    while (input[j]!='\0')
       j++;
    j--;
    while(i<j)
    {
      if(input[i]!= input[j])
        return 0;
      i++;
      j--;
    }
 
return 1;
}

void copy(char input[] , char output[])
{
    int i ;
    for(i = 0 ; input[i] != '\0' ; i++)
    {
        output[i] = input[i];
    }
    output[i] = '\0';
}

int stringlength(char input[])
{
    int i = 0;
  while(input[i] != '\0')
  {
      i++;
  }
  return i;
}

void substring(char input[] , char output[])
{
    int n, i = 0, p;
    printf("--NOTE--\nThe indices of the string start from 0\n");
    printf("\nEnter the index from where the substring is to be created : ");
    scanf("%d", &p);
    n = stringlength(input);
    if (p >= n)
    {
        printf("Invalid index!\n");
        return;
    }
    while (input[p+i] != '\0')
    {
        output[i] = input[p+i];
        i++;
    }
    output[i] = '\0';
}

void reverse(char input[] , char output[])
{
    int i , n = 0 ;
    n = stringlength(input);
    for(i = 0 ; i<n ; i++)
    {
        output[i] = input[n - 1 - i];
    }
    output[i] = '\0';
}
